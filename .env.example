# MongoDB Configuration
# IMPORTANT: Change these values before deploying!
# Copy this file to .env and fill in your actual values with strong passwords

# MongoDB Root Credentials (use a strong password with min 12 chars, uppercase, lowercase, numbers, and symbols)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=ChangeMe123!SecurePassword

# MongoDB Database Name
MONGODB_DATABASE=DroneDelivery
